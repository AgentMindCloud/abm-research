 "refine_rules": [
  {
   "id": "stripe_like_payments",
   "when": {
    "archetype_in": [
     "cloud_infra"
    ],
    "text_matches": "payment|checkout|billing infrastructure|money transfer"
   },
   "action": {
    "set": [
     "payments"
    ]
   }
  },
  {
   "id": "brokerage_is_trading",
   "when": {
    "archetype_in": [
     "market_data"
    ],
    "text_matches": "\\btrade\\b|trading|brokerage|execute .*order|manage .*portfolio|invest\\b|investing"
   },
   "action": {
    "set": [
     "trading"
    ]
   }
  },
  {
   "id": "crypto_exchange_trading",
   "when": {
    "archetype_in": [
     "market_data",
     "payments_banking"
    ],
    "text_matches": "crypto|blockchain exchange|digital asset|token trading|wallet"
   },
   "action": {
    "add": [
     "trading"
    ]
   }
  },
  {
   "id": "logistics_shipping",
   "when": {
    "archetype_in": [
     "ecommerce_logistics"
    ],
    "text_matches": "shipping|logistics|freight|fulfil|fulfill|carrier|parcel|label|track.*package"
   },
   "action": {
    "add": [
     "shipping"
    ]
   }
  },
  {
   "id": "payroll_capability",
   "when": {
    "archetype_in": [
     "hr_recruiting",
     "payments_banking",
     "accounting_billing"
    ],
    "text_matches": "payroll|contractor pay|benefits admin|gusto|\\bdeel\\b|remote pay"
   },
   "action": {
    "add": [
     "payroll"
    ]
   }
  },
  {
   "id": "invoicing_capability",
   "when": {
    "archetype_in": [
     "accounting_billing",
     "payments_banking"
    ],
    "text_matches": "invoic"
   },
   "action": {
    "add": [
     "invoicing"
    ]
   }
  },
  {
   "id": "support_from_feedback",
   "when": {
    "archetype_in": [
     "forms_surveys"
    ],
    "text_matches": "customer feedback|voice of customer|nps|support"
   },
   "action": {
    "add": [
     "support_desk"
    ]
   }
  },
  {
   "id": "identity_kyc",
   "when": {
    "archetype_in": [
     "security",
     "cloud_infra"
    ],
    "text_matches": "\\bkyc\\b|verify identit|identity verif|authentication|prevent fraud"
   },
   "action": {
    "add": [
     "identity"
    ]
   }
  }
 ]
}