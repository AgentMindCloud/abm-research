{
 "_schema": {
  "purpose": "The controlled vocabulary of functional CAPABILITIES — the jobs a connector can do. This is the language in which 'does Claude + {connectors} make a use case?' is answered. Each capability has a workflow role (input / store / output), a domain, and link flags that decide whether two capabilities connect through Claude into one workflow.",
  "fields": {
   "domain": "one of data/domains.json",
   "roles": "workflow roles the capability plays: input (brings information in), store (holds/organises records), output (produces an effect or artifact). Claude is always the processor in the middle and is itself a fallback output (it answers in chat).",
   "glue": "productivity/coordination/knowledge capability that attaches across many domains",
   "reaches_specialist": "(glue only) whether it can attach even to specialist islands. Communication glue (email/chat/calendar) = false: you communicate about operational work, not raw specialist data feeds. Work/knowledge glue (notes/tasks/files/search/automation) = true: you can document, track, automate or search anything.",
   "specialist": "domain-locked capability that only links (for non-glue capabilities) inside its own domain or via an explicit pairs_with. Operational specialists (monitoring, a store, recruiting) are still reachable by communication glue — you coordinate them over chat/email.",
   "island": "a specialist that is also a pure data/knowledge feed (market data, a brokerage, case-law, a research DB): communication glue (email/chat/calendar) cannot reach it, so e.g. Gmail+brokerage stays incoherent. Work/knowledge glue still can.",
   "pairs_with": "explicit cross-domain links a specialist is allowed to form",
   "irreversible_output": "using this capability as an output can incur an irreversible side effect (send/pay/trade/post)"
  }
 },
