{
  "_schema": {
    "purpose": "Hand-labeled held-out ground truth. Written BEFORE any inference rule existed, so rules cannot be fitted to it.",
    "authored": "2026-07-26",
    "sample": "60 connectors, seeded stratified draw (seed 20260726) across archetypes, balanced 30 rich-description / 30 terse-description",
    "method": "Each label derived by hand from the connector's directory description plus knowledge of the vendor's actual product. No archetype defaults consulted.",
    "key_vocabulary": [
      "email", "phone", "domain", "company", "person", "handle",
      "url:permalink", "url:artifact", "url:auth",
      "timestamp",
      "file:blob", "file:ref", "image", "media", "code",
      "rows:tabular", "rows:timeseries",
      "money:txn", "money:amount",
      "geo:point", "geo:region",
      "ticker", "project", "vendor_id"
    ],
    "text_is_not_a_key": "Free text is deliberately absent from the vocabulary. It is Claude-as-adapter (lossy, per composition.md) and is modelled as an INFERRED bridge with its own cost, never as a join edge.",
    "verbs": ["read", "search", "create", "update", "delete", "export", "execute"],
    "side_effects": ["read", "create", "mutate", "irreversible"]
  },
